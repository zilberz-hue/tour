rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /trips/{tripId}/{file} {
      allow read, write: if request.auth != null
        && (request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.members
            || request.auth.token.email.lower() in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.inviteEmails)
        && (request.resource == null || request.resource.size < 15 * 1024 * 1024);
    }
  }
}
